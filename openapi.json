  "components": {
    "schemas": {
      "AnalyzeIn": {
        "properties": {
          "analysis_type": {
            "type": "string",
            "const": "library_preference",
            "title": "Analysis Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_type"
        ],
        "title": "AnalyzeIn"
      },
      "AnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "AnswerIn"
      },
      "ApprovalIn": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "identity_verification": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity Verification"
          },
          "analysis": {
            "additionalProperties": true,
            "type": "object",
            "title": "Analysis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "upload_id",
          "user_id",
          "identity_verification",
          "analysis"
        ],
        "title": "ApprovalIn"
      },
      "AttachmentIn": {
        "properties": {
          "message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Message Id"
          },
          "attachment_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Attachment Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 220,
            "minLength": 1,
            "title": "Filename"
          },
          "content_base64": {
            "type": "string",
            "minLength": 1,
            "title": "Content Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id",
          "attachment_id",
          "filename",
          "content_base64"
        ],
        "title": "AttachmentIn"
      },
      "AttachmentMeta": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "file_type": {
            "type": "string",
            "const": "txt",
            "title": "File Type"
          },
          "validation_status": {
            "type": "string",
            "const": "valid",
            "title": "Validation Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_id",
          "filename",
          "file_type",
          "validation_status"
        ],
        "title": "AttachmentMeta"
      },
      "EmailEventIn": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Event Id"
          },
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "upload_code": {
            "type": "string",
            "title": "Upload Code"
          },
          "sender": {
            "$ref": "#/components/schemas/Sender"
          },
          "email": {
            "$ref": "#/components/schemas/EmailMeta"
          },
          "attachment": {
            "$ref": "#/components/schemas/AttachmentMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "upload_id",
          "upload_code",
          "sender",
          "email",
          "attachment"
        ],
        "title": "EmailEventIn"
      },
      "EmailMeta": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1,
            "title": "Subject"
          },
          "message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Message Id"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "message_id",
          "received_at"
        ],
        "title": "EmailMeta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Sender": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "Sender"
      },
      "SessionIn": {
        "properties": {
          "target_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Target Name"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_name",
          "consent"
        ],
        "title": "SessionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}